# Copy to stack.env, or paste into your Docker UI's stack environment, and edit.
# Every value below is a placeholder — none of it is a working configuration.

# ─── Where to watch ───────────────────────────────────────────────────────────
# Radius in km around the centre point. Set to 0 to disable radius matching and
# rely on FOGOS_LOCATIONS alone.
FOGOS_MAX_DISTANCE_KM=15

# Centre point in decimal degrees. Also used to show how far away and in which
# direction each occurrence is, even when the radius itself is disabled.
FOGOS_CENTER_LAT=38.7223
FOGOS_CENTER_LON=-9.1393

# Always alert on these places regardless of distance. Accent- and
# case-insensitive; matched against district, concelho, freguesia and locality.
FOGOS_LOCATIONS=Sintra,Mafra

# ─── How loud ─────────────────────────────────────────────────────────────────
# Minutes between polls. Minimum 1; 5 is plenty for how fast ANEPC data moves.
FOGOS_POLL_MINUTES=5

# Minimum severity for a NEW fire to be worth an email: info | elevated | major
#   info     — everything inside the geofence
#   elevated — 20+ operacionais, or any aircraft
#   major    — 50+ operacionais, or 2+ aircraft
# Updates and resolutions for already-reported fires are always sent.
FOGOS_MIN_SEVERITY=info

# Hours between "still watching" summary emails. 0 disables them, but then
# silence becomes ambiguous: no alerts and a dead container look identical.
FOGOS_HEARTBEAT_HOURS=24

# ─── Email ────────────────────────────────────────────────────────────────────
# Comma-separated list of recipients.
EMAIL_TO=you@example.com
EMAIL_FROM=FogosPT Alerts <alerts@example.com>

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
SMTP_STARTTLS=true
SMTP_SSL=false

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Must point at a writable volume, or every restart re-alerts every active fire.
FOGOS_STATE_DIR=/data
LOG_LEVEL=INFO

# Render and log emails without sending them. Useful for a first dry run.
FOGOS_DRY_RUN=false
